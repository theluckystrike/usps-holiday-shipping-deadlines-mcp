    "url": "https://github.com/theluckystrike/usps-holiday-shipping-deadlines-mcp"
  },
  "homepage": "https://www.mcpstamp.com/servers/",
  "bin": {
    "usps-holiday-shipping-deadlines-mcp": "dist/stdio.js"
  },
  "main": "dist/stdio.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
